{
  "name": "azure-pipelines-library",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "Dmitry Zhukovsky",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=21.1.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "biome lint",
    "test": "bun test src",
    "preview": "vite preview",
    "package": "bun run build && tfx extension create --manifests vss-extension.json",
    "package:dev": "bun run build && tfx extension create --manifests vss-extension.json --overrides-file vss-extension.dev.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^4.44.0",
    "azure-devops-extension-api": "^5.275.0",
    "azure-devops-extension-sdk": "^5.0.0",
    "azure-devops-ui": "^2.277.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "sass-embedded": "^1.100.0",
    "tfx-cli": "^0.23.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core"
  ]
}